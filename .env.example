NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Without these, OTP codes are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=auth@example.com

# Bootstrap admin created by `bun run db:seed`. Leave the password empty to skip
# creating the account; an existing email is never overwritten.
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# e2e tests. Own database; its name must end with _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test
